# Copy to frontend/.env.local for local overrides (gitignored). Vite only
# exposes variables prefixed VITE_ to client code (see src/api/client.ts).

# Base URL of the backend API, WITHOUT a trailing slash and WITHOUT /api.
# - Local dev: leave unset/empty. Vite's dev server proxies /api to
#   http://localhost:4000 (see vite.config.ts) so same-origin requests work.
# - Production: set to your deployed backend's origin, e.g.
#   https://loglens-api.onrender.com — this is read at BUILD time, so it
#   must be set in your hosting platform's build environment (e.g. Vercel
#   project settings), not just at runtime.
VITE_API_BASE_URL=
