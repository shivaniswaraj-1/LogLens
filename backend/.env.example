# Copy to backend/.env for local development (gitignored, never commit real
# values). See README.md "Deployment" for which of these must be set on the
# hosting platform in production and where each value comes from there.

# --- Local development ---
# Local Postgres (docker-compose.yml provisions a matching db/user/password).
DATABASE_URL="postgresql://loglens:loglens@localhost:5432/loglens?schema=public"
PORT=4000
# Any long random string works for local dev; production needs a real secret
# (see below).
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
NODE_ENV=development
# Must exactly match the origin the frontend is served from (scheme+host+port).
CORS_ORIGIN="http://localhost:5173"
MAX_UPLOAD_SIZE_BYTES=5242880

# --- Production (set these on the hosting platform, e.g. Render/Railway —
# never in this file or in source control) ---
# DATABASE_URL   -> the connection string from your managed Postgres
#                   instance (Render/Railway/Neon/Supabase all provide one).
# PORT           -> usually injected automatically by the platform; only set
#                   it explicitly if the platform requires it.
# JWT_SECRET     -> a long random value, e.g. `openssl rand -base64 48`.
#                   Rotating it invalidates all existing sessions.
# JWT_EXPIRES_IN -> "8h" is a reasonable default; tighten for production use.
# NODE_ENV       -> "production"
# CORS_ORIGIN    -> the deployed frontend's exact origin, e.g.
#                   https://loglens.vercel.app (no trailing slash).
# MAX_UPLOAD_SIZE_BYTES -> keep in sync with any reverse-proxy body-size
#                   limit in front of the API, if one exists.
